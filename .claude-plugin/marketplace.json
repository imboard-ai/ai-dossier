{
  "name": "ai-dossier",
  "version": "1.0.0",
  "description": "MCP server for signed, versioned agent skills (Dossier) — discover, verify, and run skills for model-driven orchestration from Claude Code",
  "owner": {
    "name": "imboard-ai",
    "email": "yuval.dimnik@gmail.com"
  },
  "plugins": [
    {
      "name": "dossier-mcp-server",
      "description": "MCP server for signed, versioned agent skills — enables LLMs to discover, verify, and run skills (.ds.md) for model-driven orchestration",
      "version": "1.0.4",
      "author": {
        "name": "Yuval Dimnik",
        "email": "yuval.dimnik@gmail.com"
      },
      "source": {
        "source": "npm",
        "package": "@ai-dossier/mcp-server"
      },
      "homepage": "https://github.com/imboard-ai/ai-dossier",
      "repository": "https://github.com/imboard-ai/ai-dossier",
      "license": "AGPL-3.0-only",
      "category": "automation",
      "keywords": [
        "dossier",
        "agent-skills",
        "model-driven-orchestration",
        "agent-orchestration",
        "mcp",
        "signed",
        "verification",
        "skill-md",
        "claude-code"
      ],
      "mcpServers": {
        "dossier": {
          "command": "npx",
          "args": ["-y", "@ai-dossier/mcp-server"]
        }
      },
      "strict": false
    }
  ]
}
