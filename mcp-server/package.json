  "bin": {
    "dossier-mcp-server": "dist/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "keywords": [
    "mcp-server",
    "model-context-protocol",
    "secure-mcp",
    "claude-code-mcp",
    "agent-skills",
    "llm-workflows",
    "skill-verification",
    "model-driven-orchestration",
    "agent-orchestration",
    "ai-agents",
    "llm",
    "skill-md",
    "claude-code",
    "claude-skills",
    "supply-chain-security",
    "signed",
    "versioning"
  ],
  "author": "Yuval Dimnik <yuval.dimnik@gmail.com>",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/imboard-ai/ai-dossier.git",
    "directory": "mcp-server"
  },
  "homepage": "https://ai-dossier.dev",
  "bugs": {
    "url": "https://github.com/imboard-ai/ai-dossier/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "commonjs",
  "mcpName": "ai.imboard/dossier",
  "files": [
    "dist/",
    "LICENSE"
  ],
  "publishConfig": {
