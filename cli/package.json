{
  "name": "@ai-dossier/cli",
  "version": "0.92.0",
  "description": "CLI for signed, versioned agent skills and model-driven orchestration: create, verify, sign, publish, and install skills for Claude Code, Codex, OpenCode, and LLM tools.",
  "main": "dist/cli.js",
  "bin": {
    "ai-dossier": "./bin/ai-dossier"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node test/smoke/login.smoke.mjs ./bin/ai-dossier"
  },
  "keywords": [
    "agent-skills",
    "claude-code-skills",
    "codex-skills",
    "signed-skills",
    "skill-registry",
    "ai-agent-cli",
    "workflow-verification",
    "model-driven-orchestration",
    "agent-orchestration",
    "ai-agents",
    "llm",
    "skill-md",
    "claude-code",
    "claude-skills",
    "supply-chain-security",
    "signed",
    "versioning"
  ],
  "author": "Imboard AI",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/imboard-ai/ai-dossier.git",
    "directory": "cli"
  },
  "homepage": "https://ai-dossier.dev",
  "bugs": {
    "url": "https://github.com/imboard-ai/ai-dossier/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@ai-dossier/core": "^1.17.0",
    "@ai-dossier/sched": "^0.69.0",
    "@ai-dossier/worktree-pool": "^0.7.0",
    "commander": "^12.1.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.0.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.9"
  }
}
