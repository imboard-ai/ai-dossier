---
const repo = 'https://github.com/imboard-ai/ai-dossier';
---
<footer>
  <div>
    <p>
      AI Dossier is open source (AGPL-3.0).
      <a href={repo}>GitHub</a> · <a href={`${repo}/releases`}>Releases</a> ·
      <a href="https://www.npmjs.com/package/@ai-dossier/cli">npm</a> ·
      <a href="/registry/">Registry</a> · <a href="/docs/">Docs</a>
    </p>
    <p class="muted">This site sets no cookies and runs no analytics or trackers.</p>
  </div>
</footer>
<style>
  footer { border-top: 1px solid var(--line); background: var(--bg-soft); }
  footer div { max-width: 1180px; margin: 0 auto; padding: 20px; font-size: .92rem; }
  footer p { margin: .2rem 0; }
</style>
