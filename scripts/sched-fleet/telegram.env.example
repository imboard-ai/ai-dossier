# Copy to telegram.env (chmod 600) in the same directory as the scripts, or wherever
# SCHED_FLEET_HOME points. Never commit the real file — tick.sh, bootstrap.sh, and
# enqueue-report.sh all `source` it for their TG() reporting helper.
HANEST_TELEGRAM_BOT_TOKEN=your-bot-token-here
HANEST_TELEGRAM_CHAT_ID=your-chat-id-here
